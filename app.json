{
  "expo": {
    "name": "Refuge",
    "slug": "refuge",
    "version": "0.9.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.refuge.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Refuge utilise le micro pour comprendre tes questions. Le son reste sur ton téléphone."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#030b11",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.refuge.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Refuge utilise la caméra pour scanner les QR codes de vos proches et allumer la lampe torche."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Refuge utilise votre position (GPS, sans Internet) pour la boussole et les points de ralliement."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Refuge enregistre votre fond d’écran d’urgence dans vos photos.",
          "savePhotosPermission": "Refuge enregistre votre fond d’écran d’urgence dans vos photos."
        }
      ],
      "llama.rn",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#16211c"
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-audio",
      "expo-localization",
      [
        "expo-contacts",
        {
          "contactsPermission": "Refuge peut importer un proche depuis tes contacts, si tu le demandes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Refuge peut joindre une photo à un repère ou à ta carte de vie.",
          "cameraPermission": "Refuge utilise la caméra pour les QR codes et les photos."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#efc61f"
        }
      ],
      "expo-asset"
    ],
    "scheme": "refuge",
    "backgroundColor": "#16211c",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f75227d6-903d-42c1-abed-11a61cba21d8"
      }
    },
    "owner": "mboccard",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/f75227d6-903d-42c1-abed-11a61cba21d8",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
